{
  "id": "whatsapp-lead-bot",
  "name": "WhatsApp Lead Bot",
  "version": "0.1.0",
  "description": "AI-powered lead qualification bot for WhatsApp with admin commands, rate limiting, and follow-ups",
  "author": "OpenClaw",
  "license": "MIT",
  "contracts": {
    "tools": [
      "add_chat_label",
      "block_lead",
      "create_label",
      "edit_quote",
      "get_followup_candidates",
      "get_labels",
      "get_lead",
      "handoff_lead",
      "list_coworkers",
      "list_leads",
      "process_cfe_receipt",
      "process_cfe_receipt_customer",
      "save_lead",
      "save_receipt_data",
      "send_disqualification",
      "send_handoff_to_ale",
      "send_receipt_request",
      "sync_labels",
      "whatsapp_history_fetch"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean"
      },
      "whatsappAccounts": {
        "type": "array",
        "items": { "type": "string" },
        "description": "WhatsApp account IDs to handle (e.g. ['default']). Leave empty to handle all accounts."
      },
      "agentNumbers": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Subset of coworkers that receive bot alerts (handoff, new lead, rate-limit). Must be a subset of the coworker whitelist resolved via coworkerAgentId."
      },
      "coworkerAgentId": {
        "type": "string",
        "description": "Agent id in openclaw.json bindings whose direct peers are treated as coworkers (bypass lead pipeline, skip lead persistence). The bindings are the single source of truth for coworker identification."
      },
      "openclawConfigPath": {
        "type": "string",
        "description": "Path to openclaw.json for the coworker whitelist. Defaults to $OPENCLAW_CONFIG_PATH or $OPENCLAW_STATE_DIR/openclaw.json or ~/.openclaw/openclaw.json."
      },
      "dryRunPrefixes": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Phone prefixes for eval/dry-run mode — messages to matching numbers skip WhatsApp delivery"
      },
      "agentId": {
        "type": "string",
        "description": "Agent ID for session key construction (defaults to first whatsappAccount or 'main')"
      },
      "dbPath": {
        "type": "string"
      },
      "rateLimit": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean" },
          "messagesPerHour": { "type": "number" },
          "windowMs": { "type": "number" },
          "notifyOnLimit": { "type": "boolean" },
          "global": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": { "type": "boolean" },
              "maxMessagesPerHour": { "type": "number" },
              "windowMs": { "type": "number" }
            }
          },
          "circuitBreaker": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": { "type": "boolean" },
              "hitRateThreshold": { "type": "number" },
              "windowMs": { "type": "number" },
              "minChecks": { "type": "number" }
            }
          }
        }
      },
      "followup": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean" },
          "silenceThresholdHours": { "type": "number" },
          "maxFollowups": { "type": "number" },
          "checkIntervalMinutes": { "type": "number" }
        }
      },
      "qualificationPrompt": {
        "type": "string"
      },
      "autoHandoffWhenQualified": {
        "type": "boolean"
      },
      "notifyNewLeads": {
        "type": "boolean"
      },
      "notifyQualified": {
        "type": "boolean"
      },
      "notifyHandoff": {
        "type": "boolean"
      },
      "receiptExtraction": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean" },
          "apiKey": { "type": "string" },
          "mediaDir": { "type": "string" },
          "maxAgeSeconds": { "type": "number" },
          "maxAttemptsPerLead": { "type": "number" },
          "maxFileSizeMB": { "type": "number" },
          "timeoutSeconds": { "type": "number" }
        }
      }
    }
  }
}
