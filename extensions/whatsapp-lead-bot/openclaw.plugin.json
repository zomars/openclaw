{
  "id": "whatsapp-lead-bot",
  "name": "WhatsApp Lead Bot",
  "version": "0.1.0",
  "description": "AI-powered lead qualification bot for WhatsApp with admin commands, rate limiting, and follow-ups",
  "author": "OpenClaw",
  "license": "MIT",
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "add_chat_label",
      "block_lead",
      "create_label",
      "crm_memory_backfill",
      "crm_sync_backfill",
      "get_followup_candidates",
      "get_labels",
      "get_lead",
      "handoff_lead",
      "list_leads",
      "process_lead_cfe_receipt",
      "save_lead",
      "save_receipt_data",
      "send_disqualification",
      "send_handoff_to_ale",
      "send_receipt_request",
      "sync_labels",
      "whatsapp_history_fetch",
      "whatsapp_native_history_probe"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "$defs": {
      "secretRef": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string",
            "enum": ["env", "file", "exec"]
          },
          "provider": { "type": "string" },
          "id": { "type": "string" }
        },
        "required": ["source", "provider", "id"]
      },
      "secretInput": {
        "anyOf": [{ "type": "string", "minLength": 1 }, { "$ref": "#/$defs/secretRef" }]
      }
    },
    "properties": {
      "enabled": {
        "type": "boolean"
      },
      "whatsappAccounts": {
        "type": "array",
        "items": { "type": "string" },
        "description": "WhatsApp account IDs to handle (e.g. ['default']). Leave empty to handle all accounts."
      },
      "agentNumbers": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Trusted operator phones that receive bot alerts and may invoke admin commands for configured WhatsApp accounts."
      },
      "dryRunPrefixes": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Phone prefixes for eval/dry-run mode — messages to matching numbers skip WhatsApp delivery"
      },
      "agentId": {
        "type": "string",
        "description": "Agent ID for session key construction (defaults to first whatsappAccount or 'main')"
      },
      "dbPath": {
        "type": "string"
      },
      "rateLimit": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean" },
          "messagesPerHour": { "type": "number" },
          "windowMs": { "type": "number" },
          "notifyOnLimit": { "type": "boolean" },
          "global": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": { "type": "boolean" },
              "maxMessagesPerHour": { "type": "number" },
              "windowMs": { "type": "number" }
            }
          },
          "circuitBreaker": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": { "type": "boolean" },
              "hitRateThreshold": { "type": "number" },
              "windowMs": { "type": "number" },
              "minChecks": { "type": "number" }
            }
          }
        }
      },
      "followup": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean" },
          "silenceThresholdHours": { "type": "number" },
          "maxFollowups": { "type": "number" },
          "checkIntervalMinutes": { "type": "number" }
        }
      },
      "qualificationPrompt": {
        "type": "string"
      },
      "autoHandoffWhenQualified": {
        "type": "boolean"
      },
      "notifyNewLeads": {
        "type": "boolean"
      },
      "notifyQualified": {
        "type": "boolean"
      },
      "notifyHandoff": {
        "type": "boolean"
      },
      "eventWebhook": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean" },
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Exact plugin HTTP route that receives signed quote completion events."
          },
          "signingSecret": {
            "$ref": "#/$defs/secretInput",
            "description": "HMAC signing secret or SecretRef used to verify inbound quote events."
          },
          "replayWindowMs": { "type": "number" },
          "maxBodyBytes": { "type": "number" },
          "rateLimit": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "maxRequests": { "type": "number" },
              "windowMs": { "type": "number" }
            }
          }
        }
      },
      "receiptExtraction": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean" },
          "apiKey": { "type": "string" },
          "mediaDir": { "type": "string" },
          "maxAgeSeconds": { "type": "number" },
          "maxAttemptsPerLead": { "type": "number" },
          "maxFileSizeMB": { "type": "number" },
          "timeoutSeconds": { "type": "number" }
        }
      },
      "crmMemory": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean" },
          "mirrorEnabled": { "type": "boolean" },
          "eventWritesEnabled": { "type": "boolean" },
          "contextReadsEnabled": { "type": "boolean" },
          "cronGateEnabled": { "type": "boolean" },
          "adminStatusEnabled": { "type": "boolean" }
        }
      }
    }
  }
}
